{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/api/admin/login",
      "destination": "/api/admin?action=login"
    },
    {
      "source": "/api/admin/session",
      "destination": "/api/admin?action=session"
    },
    {
      "source": "/api/admin/logout",
      "destination": "/api/admin?action=logout"
    },
    {
      "source": "/api/admin/announcements",
      "destination": "/api/admin?action=announcements"
    },
    {
      "source": "/api/admin/announcement-assets",
      "destination": "/api/admin?action=announcement-assets"
    },
    {
      "source": "/api/admin/promotions",
      "destination": "/api/admin?action=promotions"
    },
    {
      "source": "/api/admin/game-visibility",
      "destination": "/api/admin?action=game-visibility"
    },
    {
      "source": "/api/admin/store-products",
      "destination": "/api/admin?action=store-products"
    },
    {
      "source": "/api/admin/store-assets",
      "destination": "/api/admin?action=store-assets"
    },
    {
      "source": "/api/admin/store-orders",
      "destination": "/api/admin?action=store-orders"
    },
    {
      "source": "/api/admin/farm-withdrawals",
      "destination": "/api/admin?action=farm-withdrawals"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; script-src 'self'; style-src 'self'; connect-src 'self'"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; script-src 'self'; style-src 'self'; connect-src 'self'"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
